generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

/**
 * * ENUMS **
 */
enum USER_STATUS_TYPE {
  ACTIVE
  INACTIVE
  BANNED
}

enum ROLE {
  USER
  ADMIN
}

enum GENDER_TYPE {
  MALE
  FEMALE
  OTHER
}

enum REACTION_TYPE {
  LOVE
  HAHA
  SAD
  ANGRY
}

enum CONVERSATION_TYPE {
  CHAT
  GROUP
}

enum FILE_TYPE {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum SUBMISSION_STATUS {
  PENDING
  RUNNING
  PARTIAL
  WA
  ACCEPTED
  CE
  MLE
  TLE
  RE
  IE
}

enum TestcaseResultStatus {
  AC
  WA
  CE
  RE
  TLE
  MLE
  IE
  SKIPPED
}

enum SubmissionKind {
  CODE
  ZIP
}

enum TestcaseVisibility {
  PUBLIC
  HIDDEN
  SYSTEM
}

enum NotificationType {
  POST_COMMENT
  COMMENT_REPLY
  POST_REACTION
  COMMENT_REACTION
  MENTION
  MESSAGE
  FOLLOW
  POST_BOOKMARK
  POST_ACTIVITY
  POST_MODERATION
  ACHIEVEMENT
  SYSTEM
}

enum ChallengeType {
  DSA
  SQL
  BACKEND
  CONTEST
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ReportStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
}

enum ReportCategory {
  SPAM
  HARASSMENT
  HATE_SPEECH
  SEXUAL_CONTENT
  VIOLENCE
  SELF_HARM
  SCAM
  IMPERSONATION
  PRIVACY_VIOLATION
  MISINFORMATION
  COPYRIGHT
  OTHER
}

enum ReportResolution {
  VALID
  INVALID
  DUPLICATE
  NOT_ENOUGH_EVIDENCE
  AUTO_RESOLVED
}

enum ModerationActionType {
  NONE
  HIDE_CONTENT
  RESTORE_CONTENT
  DELETE_CONTENT
  LOCK_CONTENT
  WARN_USER
  TEMP_BAN_USER
  PERMANENT_BAN_USER
  LIMIT_USER
  DISMISS_REPORT
}

enum ModerationSignalType {
  USER_REPORT
  REPORT_COUNT
  REPORTER_TRUST
  AI_TEXT_SCORE
  AI_IMAGE_SCORE
  TARGET_AUTHOR_HISTORY
  TARGET_VELOCITY
  DUPLICATE_REPORT
  RATE_LIMIT_TRIGGER
}

enum CONVERSATION_SCOPE {
  GENERAL
  TOPIC_DISCUSSION
  CHALLENGE_HELP
  STUDY_GROUP
  CLASS_GROUP
  AI_TUTOR
}

enum ConversationRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MESSAGE_TYPE {
  TEXT
  SYSTEM
  CALL
}

/**
 * * MODELS **
 */
model User {
  id               String           @id @default(uuid())
  email            String           @unique @db.VarChar(255)
  password_hash    String           @db.VarChar(255)
  username         String           @unique @db.VarChar(100)
  fullname         String?          @db.VarChar(255)
  avatar           String?
  avatar_public_id String?          @db.VarChar(255)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now()) @updatedAt
  role             ROLE             @default(USER)
  is_deleted       Boolean          @default(false)
  deleted_at       DateTime?
  status           USER_STATUS_TYPE @default(ACTIVE)

  Profile                 Profile?
  Post                    Post[]
  PostSaved               PostSaved[]
  Comment                 Comment[]
  Reaction                Reaction[]
  FollowerFollowed        Follower[]               @relation("followed")
  FollowerFollow          Follower[]               @relation("follower")
  ConversationUser        ConversationUser[]
  MessageSent             Message[]                @relation("sender")
  AlMessage               AlMessage[]
  Notification            Notification[]
  ReportCreated           Report[]                 @relation("reporter")
  InterestedTopic         InterestedTopic[]
  Submission              Submission[]
  Leaderboard             Leaderboard[]
  ReportUser              ReportUser[]
  ActivityLogs            ActivityLogs[]
  Comment_Rate            Comment_Rate[]
  blocks                  Block[]                  @relation("blocker")
  blockedBy               Block[]                  @relation("blocked")
  refreshTokens           RefreshToken[]
  attachments             Attachment[]
  learningRecommendations LearningRecommendation[]
  userTopicMasteries      UserTopicMastery[]
  assignedReportCases     ReportCase[]             @relation("case_assigned_to")
  resolvedReportCases     ReportCase[]             @relation("case_resolved_by")
  reporterTrust           ReporterTrust?
  moderationActionLogs    ModerationActionLog[]
  reportCases             ReportCase[]
  CallStarted             Call[]                   @relation("CallCaller")
  CallReceived            Call[]                   @relation("CallReceiver")
  CallEnded               Call[]                   @relation("CallEndedBy")
}

enum MODERATION_STATUS {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  FAILED
}

model Profile {
  id              String       @id @default(uuid())
  user_id         String       @unique
  bio             String?
  cover           String?
  cover_public_id String?      @db.VarChar(255)
  dob             DateTime?
  gender          GENDER_TYPE?
  location        String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @default(now()) @updatedAt

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model InterestedTopic {
  id       String @id @default(uuid())
  user_id  String
  topic_id String

  User  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic_id])
}

model UserTopicMastery {
  id       String @id @default(uuid())
  user_id  String
  topic_id String

  mastery_score  Float @default(0)
  weakness_score Float @default(0)

  solved_count Int @default(0)
  failed_count Int @default(0)

  last_practiced_at DateTime?
  updated_at        DateTime  @updatedAt

  User  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic_id])
  @@index([topic_id])
  @@index([user_id, mastery_score])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String?
  is_deleted  Boolean @default(false)
  Topic       Topic[]
}

model Topic {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  slug        String  @unique @db.VarChar(150)
  category_id String
  parent_id   String?
  description String?
  is_deleted  Boolean @default(false)

  Category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  Parent   Topic?  @relation("TopicTree", fields: [parent_id], references: [id])
  Children Topic[] @relation("TopicTree")

  PostTopics              PostTopic[]
  ChallengeTopics         ChallengeTopic[]
  InterestedTopic         InterestedTopic[]
  posts                   Post[]
  conversations           Conversation[]
  submissionAITopics      SubmissionAITopic[]
  learningRecommendations LearningRecommendation[]
  userTopicMasteries      UserTopicMastery[]

  @@index([category_id])
  @@index([parent_id])
}

model Post {
  id                String            @id @default(uuid())
  user_id           String
  title             String
  content           String
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now()) @updatedAt
  is_deleted        Boolean           @default(false)
  deleted_at        DateTime?
  moderation_status MODERATION_STATUS @default(NOT_REQUIRED)
  moderation_reason String?
  moderated_at      DateTime?

  User       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  PostTopics PostTopic[]
  PostSaved  PostSaved[]
  Image      Image[]
  Comment    Comment[]
  Reaction   Reaction[]
  ReportPost ReportPost[]
  topic      Topic?       @relation(fields: [topicId], references: [id])
  topicId    String?

  @@index([user_id])
  @@index([created_at])
}

model PostTopic {
  id       String @id @default(uuid())
  post_id  String
  topic_id String

  Post  Post  @relation(fields: [post_id], references: [id], onDelete: Cascade)
  Topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([post_id, topic_id])
  @@index([topic_id])
}

model PostSaved {
  id       String   @id @default(uuid())
  user_id  String
  post_id  String
  saved_at DateTime @default(now())

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
}

model Image {
  id        String  @id @default(uuid())
  post_id   String
  url       String  @db.VarChar(255)
  public_id String? @db.VarChar(255)
  Post      Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)
}

model Comment {
  id               String    @id @default(uuid())
  user_id          String
  post_id          String
  parentComment_id String?
  comment_detail   String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt
  is_deleted       Boolean   @default(false)
  deleted_at       DateTime?

  User          User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Post          Post            @relation(fields: [post_id], references: [id], onDelete: Cascade)
  parentComment Comment?        @relation("CommentParentChild", fields: [parentComment_id], references: [id], onDelete: Cascade)
  childComments Comment[]       @relation("CommentParentChild")
  ReportComment ReportComment[]
  Comment_Rate  Comment_Rate[]

  @@index([post_id, created_at])
  @@index([parentComment_id])
}

model Comment_Rate {
  id         String   @id @default(uuid())
  user_id    String
  comment_id String
  rating     Int      @default(0)
  created_at DateTime @default(now())

  User    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Comment Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, comment_id])
}

model Reaction {
  id         String        @id @default(uuid())
  user_id    String
  post_id    String
  type       REACTION_TYPE
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
}

model Follower {
  id          String @id @default(uuid())
  follow_id   String
  followed_id String

  follower User @relation("followed", fields: [follow_id], references: [id], onDelete: Cascade)
  followed User @relation("follower", fields: [followed_id], references: [id], onDelete: Cascade)

  @@unique([follow_id, followed_id])
}

model Block {
  id         String @id @default(uuid())
  blocker_id String
  blocked_id String

  Blocker User @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  Blocked User @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
}

model Conversation {
  id    String             @id @default(uuid())
  type  CONVERSATION_TYPE  @default(CHAT)
  scope CONVERSATION_SCOPE @default(GENERAL)

  name   String?
  avatar String?

  topic_id     String?
  challenge_id String?

  last_message_id String?
  last_message_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  Topic       Topic?     @relation(fields: [topic_id], references: [id], onDelete: SetNull)
  Challenge   Challenge? @relation(fields: [challenge_id], references: [id], onDelete: SetNull)
  LastMessage Message?   @relation("ConversationLastMessage", fields: [last_message_id], references: [id], onDelete: SetNull)

  ConversationUser ConversationUser[]
  Message          Message[]          @relation("ConversationMessages")
  Call             Call[]
  messages         Message[]

  @@index([scope])
  @@index([topic_id])
  @@index([challenge_id])
  @@index([last_message_at])
}

model ConversationUser {
  id              String           @id @default(uuid())
  conversation_id String
  user_id         String
  role            ConversationRole @default(MEMBER)
  joined_at       DateTime         @default(now())
  left_at         DateTime?

  Conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
}

model Message {
  id              String       @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String?
  type            MESSAGE_TYPE @default(TEXT)
  call_id         String?
  sent_at         DateTime     @default(now())
  updated_at      DateTime     @default(now()) @updatedAt
  is_read         Boolean      @default(false)
  is_deleted      Boolean      @default(false)
  deleted_at      DateTime?

  Conversation  Conversation    @relation("ConversationMessages", fields: [conversation_id], references: [id], onDelete: Cascade)
  Sender        User            @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  Call          Call?           @relation("CallMessage", fields: [call_id], references: [id], onDelete: SetNull)
  Attachment    Attachment[]
  ReportMessage ReportMessage[]

  LastForConversation Conversation[] @relation("ConversationLastMessage")
  conversation        Conversation?  @relation(fields: [conversationId], references: [id])
  conversationId      String?

  @@index([conversation_id, sent_at])
  @@index([conversation_id, is_deleted, sent_at])
  @@index([conversation_id, is_read, is_deleted, sender_id])
  @@index([call_id])
}

model Attachment {
  id         String  @id @default(uuid())
  message_id String
  userId     String?

  file_path     String?
  public_id     String?
  resource_type String?
  delivery_type String?

  file_type     FILE_TYPE?
  original_name String?
  mime_type     String?
  size          Int?

  uploaded_at DateTime @default(now())

  Message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  User    User?   @relation(fields: [userId], references: [id])
}

model AlMessage {
  id      String   @id @default(uuid())
  user_id String
  content String
  sent_at DateTime @default(now())
  role    String   @default("user")

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum CALL_TYPE {
  AUDIO
  VIDEO
}

enum CALL_STATUS {
  RINGING
  ONGOING
  ENDED
  MISSED
  REJECTED
  CANCELED
  FAILED
}

model Call {
  id              String  @id @default(uuid())
  conversation_id String
  caller_id       String
  receiver_id     String?

  type   CALL_TYPE
  status CALL_STATUS @default(RINGING)

  started_at  DateTime  @default(now())
  answered_at DateTime?
  ended_at    DateTime?
  ended_by_id String?

  Conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  Caller   User  @relation("CallCaller", fields: [caller_id], references: [id], onDelete: Cascade)
  Receiver User? @relation("CallReceiver", fields: [receiver_id], references: [id], onDelete: SetNull)
  EndedBy  User? @relation("CallEndedBy", fields: [ended_by_id], references: [id], onDelete: SetNull)

  Messages Message[] @relation("CallMessage")

  @@index([conversation_id])
  @@index([caller_id])
  @@index([receiver_id])
  @@index([status])
  @@index([started_at])
}

model Language {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(50)
  code      String  @unique @db.VarChar(20)
  runtime   String? @db.VarChar(50)
  is_active Boolean @default(true)

  Submission Submission[]

  @@index([code])
}

model Challenge {
  id          String  @id @default(uuid())
  title       String  @db.VarChar(255)
  description String? @db.Text

  input       String? @db.Text
  output      String? @db.Text
  constraints String? @db.Text

  difficulty ChallengeDifficulty @default(EASY)
  type       ChallengeType       @default(DSA)

  point        Int  @default(100)
  time_limit   Int?
  memory_limit Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  config          ChallengeConfig?
  Testcase        Testcase[]
  Submission      Submission[]
  Leaderboard     Leaderboard[]
  challengeTopics ChallengeTopic[]
  conversations   Conversation[]

  @@index([type])
  @@index([difficulty])
  @@index([created_at])
}

model ChallengeTopic {
  id           String @id @default(uuid())
  challenge_id String
  topic_id     String
  weight       Float  @default(1.0)

  Challenge Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  Topic     Topic     @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, topic_id])
  @@index([topic_id])
}

model ChallengeConfig {
  id           String @id @default(uuid())
  challenge_id String @unique

  submission_kind SubmissionKind? @default(CODE)
  required_port   Int?            @default(3000)
  health_path     String?         @default("/health") @db.VarChar(255)
  start_command   String?         @default("npm start") @db.VarChar(255)

  allow_network       Boolean @default(false)
  allow_file_write    Boolean @default(false)
  max_project_size_mb Int?    @default(5)
  max_output_kb       Int?    @default(256)

  allowed_dependencies Json?
  api_contract         Json?
  security_policy      Json?

  database_mode String? @db.VarChar(50)

  Challenge Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
}

model Testcase {
  id           String @id @default(uuid())
  challenge_id String

  name        String?            @db.VarChar(255)
  score       Int                @default(1)
  visibility  TestcaseVisibility @default(HIDDEN)
  order_index Int                @default(0)

  input_json    Json?
  expected_json Json?

  input_path           String? @db.Text
  expected_output_path String? @db.Text
  schema_path          String? @db.Text

  Challenge Challenge                  @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  steps     TestcaseStep[]
  results   SubmissionTestcaseResult[]

  @@index([challenge_id])
  @@index([challenge_id, visibility])
  @@index([challenge_id, order_index])
}

model TestcaseStep {
  id          String @id @default(uuid())
  testcase_id String

  name        String? @db.VarChar(255)
  order_index Int     @default(0)

  method String @db.VarChar(10)
  path   String @db.VarChar(500)

  headers_json Json?
  body_json    Json?

  expected_status       Int
  expected_json         Json?
  expected_headers_json Json?

  assert_json    Json?
  save_variables Json?

  score Int @default(1)

  Testcase Testcase @relation(fields: [testcase_id], references: [id], onDelete: Cascade)

  @@index([testcase_id])
  @@index([testcase_id, order_index])
}

model Submission {
  id           String @id @default(uuid())
  challenge_id String
  user_id      String
  language_id  String

  kind      SubmissionKind @default(CODE)
  code      String?        @db.Text
  file_path String?        @db.Text

  status SUBMISSION_STATUS @default(PENDING)
  score  Int?              @default(0)

  submitted_at DateTime  @default(now())
  started_at   DateTime?
  finished_at  DateTime?

  runtime_ms    Int?
  memory_kb     Int?
  error_message String? @db.Text

  Challenge Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Language  Language  @relation(fields: [language_id], references: [id], onDelete: Cascade)

  testcase_results        SubmissionTestcaseResult[]
  leaderboard             Leaderboard?
  submissionAIInsight     SubmissionAIInsight?
  learningRecommendations LearningRecommendation[]

  @@index([user_id])
  @@index([challenge_id])
  @@index([language_id])
  @@index([user_id, status])
  @@index([challenge_id, status])
  @@index([user_id, challenge_id])
  @@index([submitted_at])
}

model SubmissionTestcaseResult {
  id            String @id @default(uuid())
  submission_id String
  testcase_id   String

  status    TestcaseResultStatus
  score     Int                  @default(0)
  max_score Int                  @default(0)

  runtime_ms Int?
  memory_kb  Int?

  message String? @db.Text
  stdout  String? @db.Text
  stderr  String? @db.Text

  created_at DateTime @default(now())

  Submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  Testcase   Testcase   @relation(fields: [testcase_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, testcase_id])
  @@index([submission_id])
  @@index([testcase_id])
}

model Leaderboard {
  id                 String @id @default(uuid())
  challenge_id       String
  user_id            String
  best_submission_id String @unique

  score        Int
  submitted_at DateTime
  updated_at   DateTime @updatedAt

  Challenge  Challenge  @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  User       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Submission Submission @relation(fields: [best_submission_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, user_id])
  @@index([challenge_id, score])
  @@index([user_id])
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  actor_id   String?
  type       NotificationType
  title      String           @db.VarChar(255)
  ref_id     String?
  ref_sub_id String?
  message    String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([user_id, created_at])
  @@index([user_id, type])
}

model ReportCase {
  id         String  @id @default(uuid())
  active_key String? @unique

  target_type ReportTargetType
  target_id   String

  status         ReportStatus   @default(OPEN)
  severity       ReportSeverity @default(MEDIUM)
  priority_score Int            @default(0)

  report_count  Int              @default(0)
  category_main ReportCategory?
  categories    ReportCategory[]

  is_auto_hidden Boolean   @default(false)
  auto_action_at DateTime?

  assigned_to_id String?
  resolved_by_id String?

  resolution     ReportResolution?
  action_taken   ModerationActionType?
  moderator_note String?

  first_reported_at DateTime  @default(now())
  last_reported_at  DateTime  @default(now())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt
  resolved_at       DateTime?
  closed_at         DateTime?

  Reports    Report[]
  Signals    ModerationSignal[]
  ActionLogs ModerationActionLog[]

  AssignedTo User?   @relation("case_assigned_to", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  ResolvedBy User?   @relation("case_resolved_by", fields: [resolved_by_id], references: [id], onDelete: SetNull)
  user       User?   @relation(fields: [userId], references: [id])
  userId     String?

  @@index([status])
  @@index([severity])
  @@index([priority_score])
  @@index([target_type, target_id])
  @@index([created_at])
}

model Report {
  id String @id @default(uuid())

  case_id     String
  reporter_id String

  category ReportCategory
  reason   String         @db.Text
  evidence String?        @db.Text

  reporter_ip String?
  user_agent  String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  is_deleted Boolean  @default(false)

  Case           ReportCase      @relation(fields: [case_id], references: [id], onDelete: Cascade)
  Reporter       User            @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reportUsers    ReportUser[]
  reportPosts    ReportPost[]
  reportComments ReportComment[]
  reportMessages ReportMessage[]
  reportReplies  ReportReply[]

  @@unique([case_id, reporter_id])
  @@index([reporter_id])
  @@index([case_id])
  @@index([category])
  @@index([created_at])
}

model ReporterTrust {
  id      String @id @default(uuid())
  user_id String @unique

  trust_score     Float @default(0.5)
  valid_reports   Int   @default(0)
  invalid_reports Int   @default(0)
  total_reports   Int   @default(0)

  last_reported_at DateTime?
  cooldown_until   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([trust_score])
}

model ModerationSignal {
  id      String @id @default(uuid())
  case_id String

  type   ModerationSignalType
  score  Float                @default(0)
  weight Float                @default(1)

  metadata   Json?
  created_at DateTime @default(now())

  Case ReportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@index([type])
  @@index([created_at])
}

model ModerationActionLog {
  id      String @id @default(uuid())
  case_id String

  actor_id String?
  action   ModerationActionType

  previous_status ReportStatus?
  new_status      ReportStatus?

  previous_data Json?
  new_data      Json?

  reason     String?  @db.Text
  created_at DateTime @default(now())

  Case  ReportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  Actor User?      @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([case_id])
  @@index([actor_id])
  @@index([action])
  @@index([created_at])
}

model ReportUser {
  id               String @id
  reported_user_id String

  Report       Report @relation(fields: [id], references: [id], onDelete: Cascade)
  ReportedUser User   @relation(fields: [reported_user_id], references: [id], onDelete: Cascade)
}

model ReportPost {
  id               String @id
  reported_post_id String

  Report       Report @relation(fields: [id], references: [id], onDelete: Cascade)
  ReportedPost Post   @relation(fields: [reported_post_id], references: [id], onDelete: Cascade)
}

model ReportComment {
  id                  String @id
  reported_comment_id String

  Report          Report  @relation(fields: [id], references: [id], onDelete: Cascade)
  ReportedComment Comment @relation(fields: [reported_comment_id], references: [id], onDelete: Cascade)
}

model ReportMessage {
  id                  String @id
  reported_message_id String

  Report          Report  @relation(fields: [id], references: [id], onDelete: Cascade)
  ReportedMessage Message @relation(fields: [reported_message_id], references: [id], onDelete: Cascade)
}

model ReportReply {
  id         String   @id @default(uuid())
  report_id  String
  message    String
  created_at DateTime @default(now())

  Report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
}

model ActivityLogs {
  id          String   @id @default(uuid())
  user_id     String
  action      String   @db.VarChar(100)
  target_type String?
  target_id   String?
  ip_address  String?
  created_at  DateTime @default(now())

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id           String   @id @default(uuid())
  user_id      String
  hashed_token String   @db.VarChar(255)
  expires_at   DateTime
  revoked      Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  device_info  String?
  last_used_at DateTime?
  revoked_at   DateTime?

  User User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_info])
  @@index([user_id, expires_at])
  @@index([user_id, revoked])
}

model SubmissionAIInsight {
  id            String @id @default(uuid())
  submission_id String @unique

  summary       String? @db.Text
  mistake_type  String? @db.VarChar(100)
  mistake_level String? @db.VarChar(50)

  explanation String? @db.Text
  suggestion  String? @db.Text

  confidence     Float?
  model_name     String? @db.VarChar(100)
  prompt_version String? @db.VarChar(50)

  created_at DateTime @default(now())

  Submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  topics SubmissionAITopic[]

  @@index([mistake_type])
  @@index([created_at])
}

model SubmissionAITopic {
  id         String @id @default(uuid())
  insight_id String
  topic_id   String
  confidence Float?

  Insight SubmissionAIInsight @relation(fields: [insight_id], references: [id], onDelete: Cascade)
  Topic   Topic               @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([insight_id, topic_id])
  @@index([topic_id])
}

model LearningRecommendation {
  id            String  @id @default(uuid())
  user_id       String
  submission_id String?
  topic_id      String?

  reason     String?  @db.Text
  priority   Int      @default(0)
  status     String   @default("ACTIVE")
  created_at DateTime @default(now())

  User                        User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Submission                  Submission?                  @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  Topic                       Topic?                       @relation(fields: [topic_id], references: [id], onDelete: SetNull)
  learningRecommendationItems LearningRecommendationItem[]

  @@index([user_id, status])
  @@index([topic_id])
}

enum RecommendationTargetType {
  POST
  CHALLENGE
  TOPIC
  CONVERSATION
}

model LearningRecommendationItem {
  id                String @id @default(uuid())
  recommendation_id String

  target_type RecommendationTargetType
  target_id   String

  rank   Int     @default(0)
  reason String? @db.Text

  Recommendation LearningRecommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)

  @@index([recommendation_id])
  @@index([target_type, target_id])
}
